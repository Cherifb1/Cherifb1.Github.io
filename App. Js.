const CONFIG = {
  btwStandaard: 21,
  vakantiegeldPct: 8,
  prijsMaand: 9,                 // Premium per maand (€)
  prijsJaar: 90,                 // Premium per jaar (€)
  bedrijfKorting: 0.05,          // 5 % voor bedrijven die medewerkers uitbetalen
  bedrijfsCode: "BEDRIJF5",      // kortingscode die je in Stripe/Mollie aanmaakt
  betaalLink: "#",               // VERVANG door je Stripe- of Mollie-betaallink
  premiumCodes: ["PREMIUM-VOORBEELD"], // codes die de vermelding op de loonstrook verwijderen
  siteNaam: "Zzp Werkbank"
};
/* ========================================= */

const $ = (s) => document.querySelector(s);
const eur = (n) => new Intl.NumberFormat("nl-NL", { style: "currency", currency: "EUR" }).format(n);
const num = (id) => {
  const v = parseFloat(String($(id).value).replace(",", "."));
  return Number.isFinite(v) ? v : 0;
};
const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

/* Navigatie */
const tools = ["uurtarief", "btw", "loonstrook", "premium"];
function show(id) {
  if (!tools.includes(id)) id = "uurtarief";
  tools.forEach((t) => $("#" + t).classList.toggle("active", t === id));
  document.querySelectorAll("nav.tools button").forEach((b) =>
    b.setAttribute("aria-current", b.dataset.tool === id ? "true" : "false"));
  try { history.replaceState(null, "", "#" + id); } catch (e) {}
  document.title = { uurtarief: "Uurtarief berekenen voor zzp'ers", btw: "Btw berekenen", loonstrook: "Loonstrook maken", premium: "Bedrijven en Premium" }[id] + " – " + CONFIG.siteNaam;
}
document.querySelectorAll("nav.tools button").forEach((b) => b.addEventListener("click", () => show(b.dataset.tool)));

/* Uurtarief */
function renderTarief() {
  const netto = num("#t-netto") * 12;
  const pensAov = (num("#t-pensioen") + num("#t-aov")) * 12;
  const lasten = num("#t-lasten") * 12;
  const bel = Math.min(Math.max(num("#t-belasting"), 0), 80) / 100;
  const uren = Math.max(num("#t-uren"), 0) * Math.max(52 - num("#t-vrij"), 0);
  const tape = $("#tape-tarief");

  if (uren <= 0) {
    tape.innerHTML = '<h2>Jouw tarief</h2><p class="warn">Vul minstens 1 factureerbaar uur per week in en houd minder dan 52 vrije weken over.</p>';
    return;
  }
  const winstNodig = (netto + pensAov) / (1 - bel);
  const reserve = winstNodig - (netto + pensAov);
  const omzet = winstNodig + lasten;
  const tarief = omzet / uren;
  tape.innerHTML =
    '<h2>Jouw tarief</h2>' +
    '<div class="line"><span>Netto voor jezelf (jaar)</span><span>' + eur(netto) + '</span></div>' +
    '<div class="line"><span>Pensioen en AOV (jaar)</span><span>' + eur(pensAov) + '</span></div>' +
    '<div class="line"><span>Reserve voor belasting</span><span>' + eur(reserve) + '</span></div>' +
    '<div class="line"><span>Zakelijke kosten (jaar)</span><span>' + eur(lasten) + '</span></div>' +
    '<div class="line sum"><span>Omzet nodig, exclusief btw</span><span>' + eur(omzet) + '</span></div>' +
    '<div class="line"><span>Factureerbare uren per jaar</span><span>' + Math.round(uren) + '</span></div>' +
    '<div class="big"><span class="amount">' + eur(tarief) + '</span><span class="label">per uur, exclusief btw</span></div>' +
    '<div class="line"><span>Inclusief ' + CONFIG.btwStandaard + ' % btw</span><span>' + eur(tarief * (1 + CONFIG.btwStandaard / 100)) + '</span></div>' +
    '<div class="line"><span>Dagtarief (8 uur), exclusief btw</span><span>' + eur(tarief * 8) + '</span></div>' +
    '<p class="note">Een schatting. Je werkelijke belasting hangt af van je winst en aftrekposten.</p>';
}

/* Btw */
function renderBtw() {
  const bedrag = num("#b-bedrag");
  const t = parseFloat($("#b-tarief").value) / 100;
  const incl = document.querySelector('input[name="b-richting"]:checked').value === "incl";
  const excl = incl ? bedrag / (1 + t) : bedrag;
  const btw = incl ? bedrag - excl : bedrag * t;
  const totaal = incl ? bedrag : bedrag + btw;
  $("#tape-btw").innerHTML =
    '<h2>Resultaat</h2>' +
    '<div class="line"><span>Bedrag exclusief btw</span><span>' + eur(excl) + '</span></div>' +
    '<div class="line"><span>Btw (' + (t * 100) + ' %)</span><span>' + eur(btw) + '</span></div>' +
    '<div class="big"><span class="amount">' + eur(totaal) + '</span><span class="label">bedrag inclusief btw</span></div>';
}
