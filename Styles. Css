:root {
--paper: #EEF2EC;
--grid: #DCE4D8;
--ink: #16233B;
--muted: #55627A;
--accent: #1B4DDB;
--accent-ink: #FFFFFF;
--tape: #FFFFFF;
--tape-line: #B9C3D6;
--warn: #9A3B00;
--font-display: "Bricolage Grotesque", "Trebuchet MS", system-ui, sans-serif;
--font-body: "Instrument Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
margin: 0;
font-family: var(--font-body);
color: var(--ink);
background-color: var(--paper);
background-image:
linear-gradient(var(--grid) 1px, transparent 1px),
linear-gradient(90deg, var(--grid) 1px, transparent 1px);
background-size: 28px 28px;
line-height: 1.55;
font-size: 16px;
}
a { color: var(--accent); }
:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }

.wrap { max-width: 1080px; margin: 0 auto; padding: 0 20px; }

header.site { padding: 20px 0 0; }
.brand { font-family: var(--font-display); font-weight: 800; font-size: 1.25rem; letter-spacing: -0.01em; }
nav.tools { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0 0; padding: 0; }
nav.tools button {
font: inherit; font-weight: 500; cursor: pointer;
padding: 9px 16px; border: 2px solid var(--ink); border-radius: 999px;
background: transparent; color: var(--ink);
}
nav.tools button[aria-current="true"] { background: var(--ink); color: #fff; }

main { padding: 36px 0 60px; }
section.tool { display: none; }
section.tool.active { display: block; }

h1 {
font-family: var(--font-display); font-weight: 800;
font-size: clamp(2rem, 5.5vw, 3.4rem); line-height: 1.05;
letter-spacing: -0.02em; margin: 0 0 12px; max-width: 16em;
}
h2 { font-family: var(--font-display); font-weight: 600; font-size: 1.35rem; margin: 0 0 10px; }
.lead { max-width: 38em; color: var(--muted); margin: 0 0 28px; }

.layout { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 32px; align-items: start; }
@media (max-width: 820px) { .layout { grid-template-columns: 1fr; } }

form.panel, .panel {
background: rgba(255,255,255,0.7);
border: 2px solid var(--ink);
border-radius: 6px;
padding: 22px;
}
.field { margin-bottom: 16px; }
.field label { display: block; font-weight: 600; margin-bottom: 4px; }
.field .hint { display: block; font-size: 0.875rem; color: var(--muted); margin-bottom: 4px; }
input[type="text"], input[type="number"], input[type="month"], select {
width: 100%; font: inherit; color: var(--ink);
padding: 10px 12px; border: 2px solid var(--ink); border-radius: 4px; background: #fff;
}
.row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
@media (max-width: 520px) { .row2 { grid-template-columns: 1fr; } }
fieldset { border: 0; padding: 0; margin: 0 0 16px; }
legend { font-weight: 600; padding: 0; margin-bottom: 6px; }
.check { display: flex; gap: 10px; align-items: flex-start; margin-bottom: 12px; }
.check input { margin-top: 5px; width: 18px; height: 18px; accent-color: var(--accent); }

/* Kasstrook: de resultaten als bonnetje */
.tape {
background: var(--tape);
border: 2px solid var(--ink);
border-bottom: 0;
padding: 22px 22px 30px;
position: relative;
font-variant-numeric: tabular-nums;
}
.tape::after {
content: ""; position: absolute; left: -2px; right: -2px; bottom: -14px; height: 14px;
background:
linear-gradient(135deg, var(--tape) 7px, transparent 0) 0 0 / 14px 14px repeat-x,
linear-gradient(225deg, var(--tape) 7px, transparent 0) 0 0 / 14px 14px repeat-x;
filter: drop-shadow(0 2px 0 var(--ink));
}
.tape h2 { margin-bottom: 14px; }
.line { display: flex; justify-content: space-between; gap: 16px; padding: 7px 0; border-bottom: 1px dashed var(--tape-line); }
.line span:first-child { color: var(--muted); }
.line.sum { border-bottom: 2px solid var(--ink); font-weight: 600; }
.line.sum span:first-child { color: var(--ink); }
.big { margin: 18px 0 6px; }
.big .amount { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.4rem, 8vw, 3.6rem); line-height: 1; letter-spacing: -0.02em; }
.big .label { display: block; color: var(--muted); }
.note { font-size: 0.875rem; color: var(--muted); margin-top: 18px; }
.warn { color: var(--warn); font-weight: 600; }

button.cta, a.cta {
display: inline-block; font: inherit; font-weight: 600; cursor: pointer; text-decoration: none;
padding: 12px 20px; border-radius: 4px; border: 2px solid var(--ink);
background: var(--accent); color: var(--accent-ink);
}
button.ghost { background: transparent; color: var(--ink); }

.benefits { padding-left: 1.1em; margin: 0 0 18px; }
.benefits li { margin-bottom: 6px; }
.price { font-family: var(--font-display); font-weight: 800; font-size: 2rem; }
.price s { font-weight: 600; font-size: 1.1rem; color: var(--muted); margin-right: 8px; }
.promo {
display: inline-block; padding: 6px 12px; margin: 6px 0 14px;
border: 2px dashed var(--ink); border-radius: 4px; font-weight: 600; letter-spacing: 0.04em; background: #FFF6CC;
}
[hidden] { display: none !important; }

/* Loonstrook */
#slip { background: #fff; border: 2px solid var(--ink); padding: 26px; font-size: 0.95rem; font-variant-numeric: tabular-nums; }
#slip h2 { font-size: 1.6rem; margin-bottom: 4px; }
#slip .meta { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 24px; margin: 14px 0 18px; }
#slip .meta div span { display: block; font-size: 0.8rem; color: var(--muted); }
#slip table { width: 100%; border-collapse: collapse; margin-bottom: 14px; }
#slip th { text-align: left; font-family: var(--font-display); font-weight: 600; padding: 6px 0; border-bottom: 2px solid var(--ink); }
#slip th:last-child, #slip td:last-child { text-align: right; }
#slip td { padding: 5px 0; border-bottom: 1px dashed var(--tape-line); }
#slip tr.total td { font-weight: 700; border-bottom: 2px solid var(--ink); }
#slip tr.info td { color: var(--muted); font-style: italic; }
#slip .foot { font-size: 0.8rem; color: var(--muted); margin-top: 14px; }
.actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 16px; }

footer.site { border-top: 2px solid var(--ink); padding: 20px 0 40px; color: var(--muted); font-size: 0.875rem; }

@media print {
body { background: #fff; }
body * { visibility: hidden; }
#slip, #slip * { visibility: visible; }
#slip { position: absolute; left: 0; top: 0; width: 100%; border: 0; }
}
